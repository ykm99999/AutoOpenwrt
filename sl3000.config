# 1. 物理架构死锁 (保持原文)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-emmc=y

# 2. 物理强制：救砖核心产物生成开关 (物理修复补丁)
# 审计：除了 U-Boot，必须勾选 TFA (Trusted Firmware-A) 才能合成 FIP
CONFIG_PACKAGE_uboot-mediatek=y
CONFIG_PACKAGE_uboot-mediatek-mt7981_sl_3000-emmc=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-emmc-ddr3=y

# 物理补充：24.10 救砖逻辑必须依赖项
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_F2FS=y

# 3. 物理内存/存储优化 (原文照抄)
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_UPGRADE_GUID=y

# 4. 物理剔除：防止其他机型干扰构建空间 (严禁画蛇添足)
# CONFIG_TARGET_mediatek_filogic_DEVICE_mediatek_mt7981-spim-nor-rfb is not set
# CONFIG_TARGET_mediatek_filogic_DEVICE_mediatek_mt7981-spim-nand-rfb is not set
